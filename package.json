{
  "name": "animke-forge",
  "productName": "Animke Forge",
  "version": "2.0.0",
  "description": "Animke Forge: fansubların bölümlerini hazırlayıp (1080p/720p, altyazı, fontlar) Animke'ye yükleyen program",
  "author": "Animke",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "headless": "node headless.js",
    "build": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.animke.forge",
    "productName": "Animke Forge",
    "copyright": "Animke",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.js",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!headless.js",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Animke Forge",
      "artifactName": "Animke-Forge-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iEmre1",
        "repo": "animke-forge",
        "releaseType": "release"
      }
    ]
  },
  "license": "UNLICENSED"
}
