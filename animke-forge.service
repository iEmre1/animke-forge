[Unit]
Description=Animke Forge (video hazirlama)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=animke
WorkingDirectory=/opt/animke-forge
ExecStart=/usr/bin/node headless.js
Restart=always
RestartSec=10
# Kapatılırken süren iş yarıda kalır; açılışta yeniden sıraya alınır.
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
